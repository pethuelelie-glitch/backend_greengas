# ==============================================================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT GREENGAS (.env.example)
# Copiez ce fichier sous le nom '.env' et complétez les valeurs selon votre environnement.
# ==============================================================================

# Clé secrète Django (Générez une chaîne aléatoire de 50+ caractères)
SECRET_KEY=votre_cle_secrete_django_ici

# Débogage
DEBUG=True

# Hôtes autorisés
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées en développement (en production, utiliser les domaines HTTPS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# En production : DEBUG=False, ALLOWED_HOSTS et SECRET_KEY à remplacer.
# SECURE_SSL_REDIRECT et les cookies sécurisés sont activés par défaut.
# Définir TRUST_X_FORWARDED_PROTO=True uniquement si le proxy TLS de confiance
# remplace lui-même l'en-tête X-Forwarded-Proto envoyé par le client.
# API_NUM_PROXIES=1 si un proxy de confiance nettoie puis transmet X-Forwarded-For.

# Base de données (MySQL WampServer ou SQLite)
DB_ENGINE=mysql
DB_NAME=db_greengas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Cache partagé (obligatoire en production, Redis recommandé)
# CACHE_URL=redis://127.0.0.1:6379/1

# Paramètres obligatoires en production (ne pas conserver les valeurs de développement)
# DB_ENGINE=mysql
# DB_NAME=greengas
# DB_USER=greengas_app
# DB_PASSWORD=secret-long-et-unique
# DB_HOST=database.internal
# DB_PORT=3306
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# SECURE_HSTS_SECONDS=31536000
# Activer seulement après validation de tous les sous-domaines HTTPS :
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
