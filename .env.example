# ==============================================================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT GREENGAS (.env.example)
# Copiez ce fichier sous le nom '.env' et complétez les valeurs selon votre environnement.
# ==============================================================================

# Clé secrète Django (Générez une chaîne aléatoire de 50+ caractères)
SECRET_KEY=votre_cle_secrete_django_ici

# Débogage
DEBUG=True

# Hôtes autorisés
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (MySQL WampServer ou SQLite)
DB_ENGINE=mysql
DB_NAME=db_greengas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
